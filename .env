APP_NAME=SupportNova
APP_ENV=development
SECRET_KEY=supportnova-super-secret-development-key-2026-xyz
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./supportnova.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Pipeline 1 — GenAI (add your keys here)
GENAI_PROVIDER=openai
GENAI_FALLBACK_PROVIDERS=grok,gemini,anthropic
GENAI_AUTO_FALLBACK=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GROK_API_KEY=
XAI_API_KEY=
GROK_MODEL=grok-2-latest
GENAI_MAX_RETRIES=3
GENAI_TIMEOUT_SECONDS=18
GENAI_TOTAL_BUDGET_SECONDS=15
PROMPT_VERSION=v2

# Pipeline 2 thresholds
DEFAULT_DEPARTMENT_CODE=REL
HIGH_VALUE_THRESHOLD=200000
REPEAT_SIMILARITY_THRESHOLD=55

# Uploads
MAX_UPLOAD_MB=15
UPLOAD_DIR=uploads

# Bootstrap admin
BOOTSTRAP_ADMIN_EMAIL=admin@nimbuscarta.example
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow!23
